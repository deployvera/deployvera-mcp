{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.deployvera/mcp",
  "title": "DeployVera",
  "description": "See, deploy and debug your existing DeployVera projects from coding agents.",
  "version": "0.4.0",
  "websiteUrl": "https://deployvera.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.deployvera.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional: Bearer dvp_... token from DeployVera panel. Omit it to sign in with the browser (OAuth).",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "deployvera-mcp",
      "version": "0.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DEPLOYVERA_TOKEN",
          "description": "DeployVera personal access token (dvp_...)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://deployvera.com/brand/icons/deployvera-app-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/deployvera/deployvera-mcp",
    "source": "github",
    "id": "1458682301"
  }
}
